# ——————————————————————————————————————————————
# 最快路径：什么都不用改，直接 docker compose up -d --build
# 不设置 PASSWORD 时用内置默认密码：admin
# 上线前请把下面这行的注释去掉并改成你自己的密码。
# ——————————————————————————————————————————————
# PASSWORD=admin

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
# REQUEST_TIMEOUT=8000
# MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
# DEBUG=false

# ——————————————————————————————————————————————
# 站点品牌与功能开关（不填则用 src/lib/site.ts 里的默认值「看看电视」）
# ——————————————————————————————————————————————

# NEXT_PUBLIC_SITE_NAME=看看电视
# NEXT_PUBLIC_SITE_MARK=看
# NEXT_PUBLIC_SITE_SLOGAN=每日一部好片
# NEXT_PUBLIC_SITE_SEARCH_PLACEHOLDER=搜索片名、演员、短剧
# NEXT_PUBLIC_SITE_TITLE_TEMPLATE=%s · 看看电视
# NEXT_PUBLIC_SITE_THEME_COLOR=#00a6ff

# 功能开关：任一设为 0 即隐藏对应入口（默认全开）
# NEXT_PUBLIC_FEATURE_REQUEST=0
# NEXT_PUBLIC_FEATURE_TIP=0
# NEXT_PUBLIC_FEATURE_NOTICE=0
# NEXT_PUBLIC_FEATURE_SHORTS=0
# NEXT_PUBLIC_FEATURE_ADMIN=0
# NEXT_PUBLIC_FEATURE_TV=0
# NEXT_PUBLIC_FEATURE_DOWNLOAD=0
# NEXT_PUBLIC_FEATURE_RANK=0

# 赞赏弹窗里的「服务器成本每月 N 元」
# NEXT_PUBLIC_SERVER_COST=75

# 软件下载清单：'平台|名称|说明|链接'，多条用英文逗号分隔
# NEXT_PUBLIC_DOWNLOADS=Android|安卓手机版|支持 5.1+|https://example.com/app.apk

# ——————————————————————————————————————————————
# 私密短剧 /shorts（也可以登录后台在「站点设置 → 私密短剧」里设，后台优先）
# ——————————————————————————————————————————————
# SHORTS_PASSWORD=
# SHORTS_SECRET=

# 业务数据（求片 / 赞赏 / 通知 / 短剧清单 / 注册用户）落盘目录，默认 <项目>/.data
# SITE_DATA_DIR=
