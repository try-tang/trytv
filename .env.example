# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/try-tang/trytv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# TRYTV_IMAGE=ghcr.io/try-tang/trytv:<版本>

# ——————————————————————————————————————————————
# 站点品牌与功能开关（改造为「君砚影视」时新增）
# 全站文案集中在 src/lib/site.ts，以下变量可覆盖而不改代码。
# ——————————————————————————————————————————————

# 站名（顶栏、页面标题、PWA）
# NEXT_PUBLIC_SITE_NAME=君砚影视
# 顶栏 Logo 单字
# NEXT_PUBLIC_SITE_MARK=君
# slogan：首页 hero 与 PWA 描述
# NEXT_PUBLIC_SITE_SLOGAN=每日一部好片
# 首页搜索框占位
# NEXT_PUBLIC_SITE_SEARCH_PLACEHOLDER=搜索片名、演员、短剧
# 子页标题模板，%s 为子页标题
# NEXT_PUBLIC_SITE_TITLE_TEMPLATE=%s · 君砚影视
# 主题色（地址栏 / PWA）
# NEXT_PUBLIC_SITE_THEME_COLOR=#00a6ff

# 功能开关：任一设为 0 即隐藏对应入口（默认全开）
# NEXT_PUBLIC_FEATURE_REQUEST=0     # 求片
# NEXT_PUBLIC_FEATURE_TIP=0         # 赞赏 + 留言板
# NEXT_PUBLIC_FEATURE_NOTICE=0      # 站长通知
# NEXT_PUBLIC_FEATURE_SHORTS=0      # 私密短剧
# NEXT_PUBLIC_FEATURE_ADMIN=0       # 管理员后台 /admin
# NEXT_PUBLIC_FEATURE_TV=0          # 电视版 /tv
# NEXT_PUBLIC_FEATURE_DOWNLOAD=0    # 软件下载 /download
# NEXT_PUBLIC_FEATURE_RANK=0        # 榜单页

# 赞赏弹窗里的「服务器成本每月 N 元」
# NEXT_PUBLIC_SERVER_COST=75

# 软件下载清单：'平台|名称|说明|链接'，多条用英文逗号分隔
# NEXT_PUBLIC_DOWNLOADS=Android|安卓手机版|支持 5.1+|https://example.com/app.apk,TV|电视版|适配遥控器|https://example.com/tv.apk

# 是否在页脚显示上游 LibreTV 的 GitHub 链接（默认不显示）
# NEXT_PUBLIC_UPSTREAM_CHECK=1

# ——————————————————————————————————————————————
# 私密短剧 /shorts
# ——————————————————————————————————————————————
# 进入口令（不设置时 /shorts 返回 503，入口点进去会提示站长未配置）
# SHORTS_PASSWORD=
# 口令 cookie 的签名密钥；不设置时依次退回 SHORTS_PASSWORD / PASSWORD
# SHORTS_SECRET=

# 业务数据（求片 / 赞赏 / 通知 / 短剧清单）落盘目录，默认 <项目>/.data
# SITE_DATA_DIR=
